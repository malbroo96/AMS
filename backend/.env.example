# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MSSQL Database
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=AMS
DB_USER=sa
DB_PASSWORD=YourPassword123
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Upload limits (multer memory buffer max size)
MAX_FILE_SIZE_MB=5

# SharePoint / Microsoft Graph (required for all file uploads)
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=

# Optional: discover with npm run sharepoint:discover
SHAREPOINT_SITE_URL=https://tenant.sharepoint.com/sites/YourSite
SHAREPOINT_DRIVE_NAME=Documents
SHAREPOINT_ROOT_FOLDER=EADMIT PORTAL/COLLEGE

# Legacy env names (still supported as fallbacks)
# TENANT_ID=
# CLIENT_ID=
# CLIENT_SECRET=
